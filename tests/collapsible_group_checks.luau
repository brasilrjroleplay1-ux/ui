-- Public groups own ordinary native controls; folding changes presentation only.
local UI = (function()
-- BUNDLE
end)()
local checks = 0
local function check(value, message) assert(value, message) checks += 1 end
local w = UI:CreateWindow({ Id = "PublicGroups", configuration = { fileName = "public_groups", autoSave = false, autoLoad = false } })
local tab = w:CreateTab({ name = "Grupos" })
tab:Select()
local group = tab:CreateGroup({ name = "Minhas ações", collapsible = true, collapsed = true })
local calls = 0
local button = group:CreateButton({ name = "Executar", callback = function() calls += 1 end })
local toggle = group:CreateToggle({ name = "Ativar", flag = "inside/toggle", value = false, callback = function() calls += 1 end })
local slider = group:CreateSlider({ name = "Quantidade", flag = "inside/slider", range = { 0, 100 }, value = 25 })
local dropdown = group:CreateDropdown({ name = "Modo", flag = "inside/dropdown", options = { "A", "B" }, value = "A" })
group.main.AbsoluteSize = Vector2.new(420, 58)
group.layout.AbsoluteContentSize = Vector2.new(420, 270)
group:Layout()
check(group.__type == "Group" and group.direction == Enum.FillDirection.Vertical, "a collapsible group defaults to native column layout")
check(group.name == "Minhas ações" and group.Card.header.label.Text == "Minhas ações", "the header uses the script's group name")
check(group:IsCollapsed() and not group.Card.body.Visible and group.main.Size.Y.Offset == 58, "collapsed starts with only the clickable header")
check(button.main.Parent == group.Card.body and toggle.main.Parent == group.Card.body and dropdown.main.Parent == group.Card.body, "native controls are created inside the foldable body")
local before = calls
group.Card.header.button.MouseButton1Click:Fire()
check(not group:IsCollapsed() and group.Card.body.Visible and group.main.Size.Y.Offset == 344 and group.Card.arrow.Rotation == 90, "clicking the header opens all its controls")
group.Card.header.button.MouseButton1Click:Fire()
check(group:IsCollapsed() and group.main.Size.Y.Offset == 58 and group.Card.arrow.Rotation == 0 and calls == before, "clicking again folds it without invoking any control callback")
group:Expand();button.interact.MouseButton1Click:Fire();toggle.interact.MouseButton1Click:Fire()
slider:Set(73);dropdown:Set("B")
check(calls == before + 2 and toggle.value and slider.value == 73 and dropdown:GetValue() == "B", "controls keep native callbacks, values and public adapters")
before = calls
group:Collapse();group:Expand();group:ToggleCollapsed();group:ToggleCollapsed()
check(not group:IsCollapsed() and calls == before and toggle.value and slider.value == 73 and dropdown:GetValue() == "B", "programmatic folding never resets values or repeats their callbacks")
check(w.controls["inside/toggle"] == toggle and w.controls["inside/slider"] == slider, "nested control flags still register for native persistence")
group.layout.AbsoluteContentSize = Vector2.new(420, 410)
group.layout:GetPropertyChangedSignal("AbsoluteContentSize"):Fire()
check(group.main.Size.Y.Offset == 484, "growing content updates the expanded group's height")
group:Collapse()
group:CreateButton({ name = "Adicionado depois" })
group.layout.AbsoluteContentSize = Vector2.new(420, 462)
group.layout:GetPropertyChangedSignal("AbsoluteContentSize"):Fire()
check(group.main.Size.Y.Offset == 58 and not group.Card.body.Visible, "adding controls while collapsed does not expose them")
group:Expand()
check(group.main.Size.Y.Offset == 536, "reopening includes controls added while folded")
local child = group:CreateGroup({ Name = "Subgrupo", Collapsible = true, Collapsed = true })
child:CreateButton({ name = "Ação interna" })
child.main.AbsoluteSize = Vector2.new(360, 58)
child.layout.AbsoluteContentSize = Vector2.new(360, 44)
child:Layout()
group:Collapse();group:Expand()
check(child:IsCollapsed() and not child.Card.body.Visible, "nested groups retain their own collapsed state when the parent is toggled")
child:Expand()
check(child.Card.body.Visible and child.Card.height == 118, "nested groups expand independently")
local regular = tab:CreateGroup()
check(not regular.Card and regular.compact, "ordinary groups keep the original compact row behavior")
local row = tab:CreateGroup({ name = "Ações em linha", collapsible = true, direction = "row" })
local rowButton = row:CreateButton({ name = "Lado a lado" })
check(not row:IsCollapsed() and row.compact and rowButton.compact and rowButton._buttonIndicator, "an explicitly horizontal foldable group retains compact native buttons")
local imageGroup = tab:CreateGroup({ name = "Ícone do script", collapsible = true, icon = 93364949241311 })
check(imageGroup.Card.header.glyph[1].node:IsA("ImageLabel") and imageGroup.Card.header.glyph[1].node.Image == "rbxassetid://93364949241311", "a custom asset icon replaces the default folder glyph")
local outside = tab:CreateDropdown({ name = "Fora do grupo", options = { "X", "Y" }, value = "X" })
outside:Open()
local pane = outside.selectionPanel
group:Collapse()
check(not pane.closed and outside._isOpen, "folding an unrelated group keeps the active dropdown open")
outside:Close();group:Expand();dropdown:Open();pane = dropdown.selectionPanel
group:Collapse()
check(pane.closed and not dropdown._isOpen and w._conexaoPanel == nil, "folding the dropdown's ancestor closes its internal selection pane")
for _, width in ipairs({ 160, 240, 420, 720 }) do
    group.main.AbsoluteSize = Vector2.new(width, 58);group:Layout()
    local label = group.Card.header.label
    local content = group.Card.header.content
    local textRight = content.Position.X.Offset + label.Position.X.Offset + label.Size.X.Offset
    local arrowLeft = width - 12 - 24
    check(textRight <= arrowLeft and content.Size.X.Offset > 0, "the header title keeps its own space before the expand arrow at " .. width .. "px")
end
group:Expand()
w:ChangeTheme("porcelana")
check(group.Card.header.label.FontFace.Family == w.theme.TitleFont.Family, "foldable groups follow theme changes")
w:Hide();w:Show()
check(not group:IsCollapsed() and toggle.value and slider.value == 73, "hide/show preserves expansion and native control values")
group:_setShown(false, false)
check(group.Card.header.label.TextTransparency == 1 and group.Card.arrow.TextTransparency == 1 and button._buttonIndicator.plate.BackgroundTransparency == 1, "hiding a group fades the header, arrow and child decorations")
group:_setShown(true, false)
check(group.Card.header.label.TextTransparency == 0 and group.Card.arrow.TextTransparency < 1, "revealing a group restores its whole header")
check(w:Save(), "controls inside a foldable group use the existing save operation")
tab:Remove()
check(group.main.Parent == nil and not w._conexaoPanel, "removing the tab tears down its foldable groups and selection pane")
w:Unload()
check(#w.connections == 0 and #w.instances == 0, "unload releases all group controls, headers and handlers")
print("PASS: " .. checks .. " public collapsible groups, nested controls and lifecycle checks")
