-- Standalone policy tests; fixture names do not endorse any product.
local Policy = require("../ConexaoUI/Features/ExecutorPolicy")
local count = 0
local function check(value, description) assert(value, description) count += 1 end
local function identity(name) return { name = name, identified = true, environment = "Roblox" } end
local rules = Policy.compile({ { name = "Cliente A", aliases = { "Cliente A Mobile" } }, "Cliente B" })
local ok, reason, canonical = Policy.check(identity("Cliente A"), rules)
check(ok and reason == "permitted" and canonical == "Cliente A", "explicitly permitted client is recognized")
ok, reason, canonical = Policy.check(identity("Cliente A Mobile"), rules)
check(ok and canonical == "Cliente A", "only explicitly declared aliases are accepted")
check(Policy.check(identity("  CLIENTE   A  "), rules), "case and whitespace variations keep the same name")
check(not Policy.check(identity("Cliente A Clone"), rules), "a known prefix does not approve a clone")
check(not Policy.check(identity("Cliente A Runtime"), rules), "a suffix requires an explicit alias")
check(not Policy.check(identity("ClienteA"), rules), "removing punctuation or separators does not widen the list")
check(not Policy.check(identity("Cliente А"), rules), "lookalike Unicode names do not grant access")
check(not Policy.check(identity("Outro Cliente"), rules), "unlisted clients are denied")
check(not Policy.check(identity("Cliente A"), Policy.compile({})), "an empty list grants no executor access")
check(not Policy.check({ name = "Cliente A", environment = "Roblox" }, rules), "a display label without an identification result is denied")
check(not Policy.check(nil, rules), "missing identity is denied")
check(not Policy.check(identity(""), rules), "blank identity is denied")
check(not Policy.check({ name = "Roblox Studio", environment = "Roblox Studio" }, rules), "Studio requires its own explicit development exception")
check(Policy.check({ environment = "Roblox Studio" }, Policy.compile({}, { allowStudio = true })), "an explicit Studio exception does not approve other clients")
check(not Policy.check(identity("Outro Cliente"), Policy.compile({}, { allowStudio = true })), "Studio access does not change the executor list")
check(not pcall(Policy.compile, nil), "a missing policy cannot silently allow all")
check(not pcall(Policy.compile, { "Cliente A", "CLIENTE A" }), "duplicate normalized names are rejected")
check(not pcall(Policy.compile, { { name = "Cliente A", aliases = { "Cliente B" } }, "Cliente B" }), "ambiguous aliases are rejected")
check(not pcall(Policy.compile, { { name = "Cliente A", aliases = "Any" } }), "malformed aliases are rejected")
check(not pcall(Policy.compile, { true }), "malformed entries are rejected")
check(not pcall(Policy.compile, { { name = "   " } }), "blank entries are rejected")
print("PASS: " .. count .. " executor-policy checks")
