  if deleted then deleted:SetOptions(store:ListProfiles(true)) end
  summary:SetValue(store.Active..'  ·  '..#store:ListProfiles()..' salvo(s)'..(store.SessionOnly and '\nCarregamento automático desativado.' or ''))
 end
