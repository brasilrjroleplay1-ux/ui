end

__modules["Core/Identity"] = function()
-- Public client metadata only. Never guesses an executor name or reads credentials.
local Players=game:GetService('Players')
local Identity={}
function Identity.new(w,options)
 local player=Players.LocalPlayer
 local executor='Não identificado'
 local env=getfenv()
 local detect=env.identifyexecutor or env.getexecutorname
 if type(detect)=='function' then
  local ok,name=pcall(detect)
  if ok and type(name)=='string' and name~='' then executor=name end
 else
  local ok,studio=pcall(function() return game:GetService('RunService'):IsStudio() end)
  if ok and studio then executor='Roblox Studio' end
 end
 local self={DisplayName=player.DisplayName or player.Name or 'Jogador',Username=player.Name or 'Jogador',UserId=player.UserId or 0,Executor=executor,Images={}}
 local avatar=options.Avatar
 if type(avatar)=='number' then avatar='rbxassetid://'..avatar end
 self.Avatar=avatar or ('rbxthumb://type=AvatarHeadShot&id='..self.UserId..'&w=150&h=150')
 function self:BindImage(image) image.Image=self.Avatar table.insert(self.Images,image) end
 if not avatar and self.UserId>0 then
  task.spawn(function()
   local ok,url,ready=pcall(function() return Players:GetUserThumbnailAsync(self.UserId,Enum.ThumbnailType.HeadShot,Enum.ThumbnailSize.Size150x150) end)
   if not ok or not ready or w.Destroyed then return end
   self.Avatar=url
   for _,image in ipairs(self.Images) do if image.Parent then image.Image=url end end
  end)
 end
 function self:Destroy() table.clear(self.Images) end
 return self
end
return Identity

end

__modules["Core/Input"] = function()
local UIS=game:GetService('UserInputService')
local Input={}
function Input.drag(handle,window,cleanup,clamp)
 local active,start,origin
 cleanup:Add(handle.InputBegan:Connect(function(i)
  if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
   active=i start=i.Position origin=window.Position
  end
 end))
 cleanup:Add(UIS.InputChanged:Connect(function(i)
  if active and (i==active or i.UserInputType==Enum.UserInputType.MouseMovement) then
   local d=i.Position-start
   window.Position=UDim2.new(origin.X.Scale,origin.X.Offset+d.X,origin.Y.Scale,origin.Y.Offset+d.Y)
   clamp()
  end
 end))
 cleanup:Add(UIS.InputEnded:Connect(function(i) if i==active or i.UserInputType==Enum.UserInputType.MouseButton1 then active=nil end end))
end
function Input.slider(track,cleanup,onFraction)
 local active
 local function update(i) onFraction(math.clamp((i.Position.X-track.AbsolutePosition.X)/math.max(track.AbsoluteSize.X,1),0,1)) end
 cleanup:Add(track.InputBegan:Connect(function(i)
  if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then active=i update(i) end
 end))
 cleanup:Add(UIS.InputChanged:Connect(function(i) if active and (i==active or i.UserInputType==Enum.UserInputType.MouseMovement) then update(i) end end))
 cleanup:Add(UIS.InputEnded:Connect(function(i) if i==active or i.UserInputType==Enum.UserInputType.MouseButton1 then active=nil end end))
end
return Input

end

__modules["Core/Notifications"] = function()
-- Notification queue, timers and UI are owned by the window, not application code.
local E = __require("Core/Elements")
local Cleanup = __require("Core/Cleanup")
local TweenService = game:GetService('TweenService')
local Notifications = {}
local kinds = {Info='Primary', Success='Success', Warning='Warning', Error='Error'}
local symbols = {Info='info', Success='✓', Warning='!', Error='×'}
local function duration(value)
 local n=tonumber(value)
 if not n or n~=n then return 5 end
 return math.clamp(n,0,86400)
end
local function validateActions(actions)
 assert(type(actions)=='table' and #actions<=5,'Actions aceita até 5 botões.')
 for _,entry in ipairs(actions) do
  assert(type(entry)=='table' and type(entry.Name)=='string','Cada ação precisa de Name.')
  assert(entry.Callback==nil or type(entry.Callback)=='function','Callback de ação inválido.')
 end
end
function Notifications.new(w,config)
 config=config or {}
 local manager={Records={},Queue={},Active={},Dead=false,Sequence=0,Cleanup=Cleanup.new()}
 local maxVisible=math.clamp(math.floor(tonumber(config.MaxVisible) or 3),1,5)
 local maxQueue=math.clamp(math.floor(tonumber(config.MaxQueue) or 50),1,200)
 local layer=E.new('ScrollingFrame',{Name='Notifications',ZIndex=50,BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollingDirection=Enum.ScrollingDirection.Y,AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,-12,1,-12)},w.Gui)
 local list=E.list(layer,10) list.VerticalAlignment=Enum.VerticalAlignment.Bottom
 E.pad(layer,4)
 manager.Layer=layer
 manager.Cleanup:Add(function() w.Theme:Forget(layer) layer:Destroy() end)
 local capacity=maxVisible
 local pump,render,finish
 local function safe(callback,...)
  if not callback then return end
  local args=table.pack(...)
  task.spawn(function()
   if manager.Dead or w.Destroyed then return end
   local ok,err=pcall(callback,table.unpack(args,1,args.n))
   if not ok then warn('[Conexão UI / notification] '..tostring(err)) end
  end)
 end
 function manager:Notify(options)
  assert(not self.Dead,'Janela destruída.')
  local o=table.clone(options or {})
  o.Actions=o.Actions or {} validateActions(o.Actions)
  assert(#self.Queue<maxQueue,'Fila de notificações cheia.')
  self.Sequence+=1
  local n={State='Queued',Options=o,Duration=duration(o.Duration),Remaining=duration(o.Duration),Paused=false,Cleanup=Cleanup.new(),TimerRevision=0,Sequence=self.Sequence}
  self.Records[n]=true
  local function stopTimer()
   n.TimerRevision+=1
   if n.Timer then pcall(task.cancel,n.Timer) n.Timer=nil end
   if n.ProgressTween then n.ProgressTween:Cancel() n.ProgressTween=nil end
  end
  function n:Pause()
   if self.State~='Visible' or self.Paused then return end
   if self.Started then self.Remaining=math.max(0,self.Remaining-(os.clock()-self.Started)) self.Started=nil end
   self.Paused=true stopTimer()
  end
  function n:Resume()
   if self.State~='Visible' then return end
   self.Paused=false stopTimer()
   if self.Duration==0 then return end
   self.Started=os.clock()
   local revision=self.TimerRevision
   if self.Fill then
    self.Fill.Size=UDim2.fromScale(math.clamp(self.Remaining/math.max(self.Duration,.001),0,1),1)
    self.ProgressTween=TweenService:Create(self.Fill,TweenInfo.new(self.Remaining,Enum.EasingStyle.Linear),{Size=UDim2.fromScale(0,1)}) self.ProgressTween:Play()
   end
   self.Timer=task.delay(self.Remaining,function()
    self.Timer=nil
    if self.State=='Visible' and self.TimerRevision==revision then self:Close('timeout') end
   end)
  end
  function n:Close(reason)
   if self.State=='Closed' or self.State=='Closing' then return end
   reason=reason or 'dismiss' self.CloseReason=reason
   stopTimer()
   if self.State=='Queued' then finish(self,reason) return end
   self.State='Closing'
   if self.Card then TweenService:Create(self.Card,TweenInfo.new(.14),{GroupTransparency=1}):Play() end
   self.Exit=task.delay(.14,function() self.Exit=nil finish(self,reason) end)
  end
  function n:Destroy() self:Close('destroy') end
  function n:SetValue(value) return self:Update({Content=tostring(value)}) end
  function n:Update(values)
   if self.State=='Closed' or self.State=='Closing' then return false end
   if values.Actions~=nil then validateActions(values.Actions) end
   for key,value in pairs(values) do self.Options[key]=value end
   if values.Duration~=nil then
    stopTimer() self.Duration=duration(values.Duration) self.Remaining=self.Duration self.Started=nil
   end
   if self.State=='Visible' then
    render(self)
    if values.Duration~=nil and not self.Paused then self:Resume()
    elseif values.PauseOnHover==false and self.Paused then self:Resume() end
   end
   return true
  end
  function n:Dispose()
   stopTimer()
   if self.Exit then pcall(task.cancel,self.Exit) self.Exit=nil end
   self.Cleanup:Destroy()
  end
  table.insert(self.Queue,n) pump()
  return n
 end
 finish=function(n,reason)
  if n.State=='Closed' then return end
  n.State='Closed' n:Dispose()
  manager.Records[n]=nil
  local i=table.find(manager.Active,n) if i then table.remove(manager.Active,i) end
  i=table.find(manager.Queue,n) if i then table.remove(manager.Queue,i) end
  safe(n.Options.OnClose,reason)
  if not manager.Dead then pump() end
 end
 render=function(n)
  local o=n.Options local semantic=kinds[o.Kind] or 'Primary'
  if not n.Card then
   local card=E.new('CanvasGroup',{Name='Notification',LayoutOrder=n.Sequence,GroupTransparency=1,BorderSizePixel=0,Size=UDim2.new(1,-8,0,0),AutomaticSize=Enum.AutomaticSize.Y},layer)
   n.Card=card E.corner(card,16) E.pad(card,14) E.list(card,10)
   w.Theme:Bind(card,'BackgroundColor3','Surface')
   local border=E.new('UIStroke',{Thickness=1,Transparency=.2},card) w.Theme:Bind(border,'Color','Border')
   local header=E.new('Frame',{BackgroundTransparency=1,Size=UDim2.new(1,0,0,36)},card) n.Header=header
   n.Title=E.text(header,'',14) n.Title.Position=UDim2.fromOffset(34,0) n.Title.Size=UDim2.new(1,-74,1,0) w.Theme:Bind(n.Title,'TextColor3','Text')
   local close=E.button(header,'×') close.Size=UDim2.fromOffset(32,32) close.Position=UDim2.new(1,-32,0,0) w.Theme:Bind(close,'BackgroundColor3','SurfaceHover')
   n.Body=E.text(card,'',13) n.Body.Size=UDim2.new(1,0,0,0) n.Body.AutomaticSize=Enum.AutomaticSize.Y w.Theme:Bind(n.Body,'TextColor3','MutedText')
   n.Actions=E.new('Frame',{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y},card) E.list(n.Actions,8)
   n.ActionCleanup=Cleanup.new()
   local rail=E.new('Frame',{BorderSizePixel=0,Size=UDim2.new(1,0,0,3)},card) E.corner(rail,2) w.Theme:Bind(rail,'BackgroundColor3','Border') n.Rail=rail
   n.Fill=E.new('Frame',{BorderSizePixel=0,Size=UDim2.fromScale(1,1)},rail) E.corner(n.Fill,2)
   n.Cleanup:Add(function() n.ActionCleanup:Destroy() w.Theme:Forget(card) card:Destroy() end)
   n.Cleanup:Add(close.Activated:Connect(function() n:Close('dismiss') end))
   n.Cleanup:Add(card.MouseEnter:Connect(function() if n.Options.PauseOnHover~=false then n:Pause() end end))
   n.Cleanup:Add(card.MouseLeave:Connect(function() if n.Options.PauseOnHover~=false then n:Resume() end end))
   TweenService:Create(card,TweenInfo.new(.18),{GroupTransparency=0}):Play()
  end
  n.Title.Text=tostring(o.Title or 'Conexão UI') n.Body.Text=tostring(o.Content or '')
  n.Body.Visible=n.Body.Text~='' n.Rail.Visible=n.Duration>0
  w.Theme:Bind(n.Fill,'BackgroundColor3',semantic)
  if n.Icon then w.Theme:Forget(n.Icon) n.Icon:Destroy() end
  n.Icon=E.icon(n.Header,o.Icon or symbols[o.Kind] or 'info') n.Icon.Position=UDim2.fromOffset(0,6)
  w.Theme:Bind(n.Icon,n.Icon:IsA('ImageLabel') and 'ImageColor3' or 'TextColor3',semantic)
  n.ActionCleanup:Destroy() n.ActionCleanup=Cleanup.new()
  n.Actions.Visible=#o.Actions>0
  for _,entry in ipairs(o.Actions) do
   local b=E.button(n.Actions,entry.Name) w.Theme:Bind(b,'BackgroundColor3',semantic) w.Theme:Bind(b,'TextColor3','Text')
   n.ActionCleanup:Add(function() w.Theme:Forget(b) b:Destroy() end)
   n.ActionCleanup:Add(b.Activated:Connect(function()
    if n.State~='Visible' then return end
    safe(entry.Callback,n)
    if entry.Close~=false then n:Close('action') end
   end))
  end
 end
 pump=function()
  if manager.Dead then return end
  while #manager.Active<capacity and #manager.Queue>0 do
   local n=table.remove(manager.Queue,1)
   if n.State=='Queued' then n.State='Visible' table.insert(manager.Active,n) render(n) n:Resume() end
  end
 end
 local function layout()
  local viewport=w.Gui.AbsoluteSize
  layer.Size=UDim2.fromOffset(math.max(1,math.min(tonumber(config.Width) or 360,viewport.X-24)),math.max(1,viewport.Y-24))
  capacity=(viewport.Y<600 or viewport.X<600) and 1 or maxVisible
  for index=#manager.Active,capacity+1,-1 do
   local n=manager.Active[index]
   if n.State=='Visible' then
    table.remove(manager.Active,index)
    n:Pause() n.Cleanup:Destroy() n.Cleanup=Cleanup.new() n.Card=nil n.Icon=nil n.State='Queued'
    table.insert(manager.Queue,1,n)
   end
  end
  pump()
 end
 manager.Cleanup:Add(w.Gui:GetPropertyChangedSignal('AbsoluteSize'):Connect(layout))
 function manager:Destroy()
  if self.Dead then return end self.Dead=true
  for n in pairs(self.Records) do n.State='Closed' n:Dispose() end
  table.clear(self.Records) table.clear(self.Queue) table.clear(self.Active)
  self.Cleanup:Destroy()
 end
 layout()
 return manager
end
return Notifications

end

__modules["Core/Options"] = function()
-- Public properties accept Name/name, Callback/callback, etc.; explicit capitalized keys win.
local Options = {}
function Options.normalize(value)
 if value==nil then return {} end
 if type(value)=='string' then return {Name=value} end
 assert(type(value)=='table','As opções devem ser uma tabela ou um nome.')
 local result=table.clone(value)
 for key,item in pairs(value) do
  if type(key)=='string' then
   local canonical=key:sub(1,1):upper()..key:sub(2)
   if result[canonical]==nil then result[canonical]=item end
  end
 end
 return result
end
return Options

end

__modules["Core/Storage"] = function()
local Http = game:GetService('HttpService')
local Storage = {}
local function copy(value)
 if type(value)~='table' then return value end
 local result={} for k,v in pairs(value) do result[k]=copy(v) end return result
end
local function validName(value)
 return type(value)=='string' and #value>0 and #value<=48 and value:match('^[%w _%-]+$')~=nil
end
function Storage.new(options)
 options = options or {}
 local self = {Values={}, Enabled=options.Enabled ~= false, Available=false, LastError=nil, Revision=0, Dead=false}
 self.Active='Default' self.AutoLoad=true self.Profiles={Default=self.Values} self.Deleted={} self.SessionOnly=false
 local env = getfenv()
 local read,write,exists,mkdir,isfolder = env.readfile,env.writefile,env.isfile,env.makefolder,env.isfolder
 local adapter = options.Adapter
 local folder = options.Folder or 'ConexaoUI'
 local name = options.Name or 'default'
 assert(folder:match('^[%w_-]+$') and name:match('^[%w_-]+$'),'Use apenas letras, números, _ e - em Folder/Name')
 local path = folder..'/'..name..'.json'
 if adapter then
  self.Read = function() return adapter:Read(name) end
  self.Write = function(data) adapter:Write(name,data) end
  self.Available = true
 elseif type(read)=='function' and type(write)=='function' and type(exists)=='function' and type(mkdir)=='function' then
  self.Read = function() if exists(path) then return read(path) end return nil end
  self.Write = function(data)
   if type(isfolder)=='function' then if not isfolder(folder) then mkdir(folder) end
   else
    -- Some implementations raise when the directory already exists. The write
    -- below remains authoritative and propagates permission errors.
    pcall(mkdir,folder)
   end
   write(path,data)
  end
  self.Available = true
 end
 function self:Report(err)
  self.LastError=tostring(err) warn('[Conexão UI / storage] '..self.LastError)
  if options.OnError then pcall(options.OnError,self.LastError) end
 end
 if self.Enabled and self.Available then
  local ok,result=pcall(self.Read)
  if ok and result then
   local decoded,data=pcall(function() return Http:JSONDecode(result) end)
   if decoded and type(data)=='table' and data.Version==1 and type(data.Values)=='table' then
    if type(data.Profiles)=='table' then
     local profiles={}
     for key,values in pairs(data.Profiles) do if validName(key) and type(values)=='table' then profiles[key]=values end end
     profiles.Default=profiles.Default or {}
     self.Profiles=profiles
     if type(data.Active)=='string' and profiles[data.Active] then self.Active=data.Active end
     if type(data.Deleted)=='table' then
      for key,values in pairs(data.Deleted) do if validName(key) and type(values)=='table' and not profiles[key] then self.Deleted[key]=values end end
     end
     self.AutoLoad=data.AutoLoad~=false
     self.SessionOnly=not self.AutoLoad
     self.Values=self.AutoLoad and profiles[self.Active] or {}
    else self.Values=data.Values self.Profiles={Default=self.Values} end
   else self:Report('Configuração inválida; valores padrão serão usados.') end
  elseif not ok then self:Report(result) end
 end
 function self:Set(id,value)
  self.Values[id]=value self.Revision+=1
  local revision=self.Revision
  task.delay(.3,function() if not self.Dead and revision==self.Revision then self:Flush() end end)
 end
 function self:Flush(force)
  if (not self.Enabled and not force) or not self.Available then return false end
  local ok,err=pcall(function() self.Write(Http:JSONEncode({Version=1,Values=self.Profiles[self.Active],Profiles=self.Profiles,Active=self.Active,Deleted=self.Deleted,AutoLoad=self.AutoLoad})) end)
  if not ok then self:Report(err) end return ok
 end
 function self:SaveProfile()
  self.SessionOnly=false self.Profiles[self.Active]=self.Values
  return self:Flush(true)
 end
 function self:ListProfiles(deleted)
  local result={} for key in pairs(deleted and self.Deleted or self.Profiles) do table.insert(result,key) end table.sort(result) return result
 end
 function self:CreateProfile(profileName)
  if profileName==nil or profileName=='' then
   local number=1 repeat profileName='Perfil '..number number+=1 until not self.Profiles[profileName] and not self.Deleted[profileName]
  end
  assert(validName(profileName),'Nome inválido: use até 48 letras, números, espaços, _ ou -.')
  assert(not self.Profiles[profileName] and not self.Deleted[profileName],'Este nome já existe ou está na lixeira.')
  assert(#self:ListProfiles()<50,'Limite de 50 perfis.')
  self.Profiles[profileName]=copy(self.Values) return profileName
 end
 function self:ActivateProfile(profileName)
  assert(self.Profiles[profileName],'Perfil não encontrado.')
  self.Active=profileName self.Values=self.Profiles[profileName] self.SessionOnly=false
 end
 function self:DeleteProfile(profileName)
  assert(profileName~='Default' and profileName~=self.Active,'O perfil padrão e o ativo não podem ser excluídos.')
  assert(self.Profiles[profileName],'Perfil não encontrado.')
  assert(#self:ListProfiles(true)<50,'Lixeira cheia: restaure um perfil antes de excluir outro.')
  self.Deleted[profileName]=self.Profiles[profileName] self.Profiles[profileName]=nil
 end
 function self:RestoreProfile(profileName)
  assert(self.Deleted[profileName] and not self.Profiles[profileName],'Perfil não disponível para restauração.')
  assert(#self:ListProfiles()<50,'Limite de 50 perfis.')
  self.Profiles[profileName]=self.Deleted[profileName] self.Deleted[profileName]=nil
 end
 function self:ExportProfile(profileName)
  local values=profileName and self.Profiles[profileName] or self.Values
  assert(values,'Perfil não encontrado.')
  return Http:JSONEncode({Version=1,Values=values})
 end
 function self:ImportProfile(text,profileName)
  assert(type(text)=='string' and #text<=262144,'Importação limitada a 256 KiB de JSON.')
  local data=Http:JSONDecode(text)
  assert(type(data)=='table' and data.Version==1 and type(data.Values)=='table','JSON de configuração inválido.')
  local created=self:CreateProfile(profileName)
  self.Profiles[created]=copy(data.Values) return created
 end
 function self:Destroy() self:Flush() self.Dead=true end
 return self
end
return Storage

end

__modules["Core/Theme"] = function()
local Theme = {}
Theme.Default = {
 Background = Color3.fromRGB(16,18,22), Surface = Color3.fromRGB(28,31,36),
 SurfaceHover = Color3.fromRGB(40,44,52), Primary = Color3.fromRGB(143,110,247),
 Secondary = Color3.fromRGB(224,184,100), Text = Color3.fromRGB(244,245,250),
 MutedText = Color3.fromRGB(155,161,177), Border = Color3.fromRGB(58,61,72),
 Success = Color3.fromRGB(105,221,160), Warning = Color3.fromRGB(245,199,100),
 Error = Color3.fromRGB(242,113,131), CornerRadius = 14,
}
function Theme.new(overrides)
 local self = {Values = table.clone(Theme.Default), Bindings = {}}
 if type(overrides) == 'table' then for k,v in pairs(overrides) do self.Values[k] = v end end
 function self:Bind(instance, property, key)
  instance[property] = self.Values[key]
  self.Bindings[instance] = self.Bindings[instance] or {}
  self.Bindings[instance][property] = key
 end
 function self:Apply(values)
  for k,v in pairs(values) do if self.Values[k] ~= nil then self.Values[k] = v end end
  for instance, props in pairs(self.Bindings) do
   if instance.Parent == nil then self.Bindings[instance] = nil else
    for property,key in pairs(props) do instance[property] = self.Values[key] end
   end
  end
 end
 function self:Forget(root)
  for instance in pairs(self.Bindings) do if instance == root or instance:IsDescendantOf(root) then self.Bindings[instance] = nil end end
 end
 return self
end
return Theme

end

__modules["Core/Window"] = function()
local E=__require("Core/Elements")
local Theme=__require("Core/Theme")
